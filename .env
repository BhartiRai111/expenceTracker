# Database Config
DB_URL=jdbc:mysql://localhost:3306/expenses_tracker
DB_USERNAME=root
DB_PASSWORD=Write_YOUR_Password

# JPA / Hibernate
JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQL8Dialect
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# Mail Config
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_EMAIL
MAIL_PASSWORD=APP_PASSWORD
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true

# Twilio Config
TWILIO_SID=SID
TWILIO_TOKEN=YOUR_TOKEN
TWILIO_PHONE=YOUR_PHONE_NUMBER

# Hugging Face
HF_TOKEN=YOUR_TOKEN
